# === Google Sheets (penyimpanan data RSVP) ===
# ID spreadsheet, diambil dari URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=
# Nama tab/sheet tempat data disimpan (dibuat otomatis jika belum ada)
GOOGLE_SHEET_NAME=RSVP
# Kredensial Service Account (dari Google Cloud Console > IAM & Admin > Service Accounts)
# Spreadsheet di atas WAJIB di-share (Editor) ke email service account ini.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# === Login Admin via Google SSO ===
# OAuth 2.0 Client ID (Web application) dari Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (sesuaikan domain saat production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Domain Google Workspace yang diizinkan login sebagai admin
ALLOWED_DOMAIN=zakatsukses.org
# Secret untuk NextAuth, generate dengan: npx auth secret
AUTH_SECRET=
